# Copy these into your shell, or into a local .env that you do not commit.
# DevSquad does not load this file for you. There are no real secrets here.

# Required for GET /health. Use a long random string of your own.
DEVSQUAD_TOKEN=replace-with-a-random-local-token

# Optional. Both default under ~/.devsquad/.
# DEVSQUAD_DB=~/.devsquad/devsquad.db
# DEVSQUAD_WORKSPACES=~/.devsquad/workspaces
